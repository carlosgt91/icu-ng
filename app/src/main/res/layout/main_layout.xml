<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Plain SurfaceView: StreamController renders into it through its own
         StreamBase GL pipeline (OpenGlView would run a second GL pipeline
         of its own on top). -->
    <SurfaceView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#B3000000"
        android:padding="@dimen/auto_margin">

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/status_neutral"
            android:textStyle="bold"
            android:paddingBottom="2dp" />

        <!-- Who streams: the ICU NG Capture app or the plugin itself. -->
        <TextView
            android:id="@+id/mode_text"
            style="@style/IcuNgCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/camera_caption"
                style="@style/IcuNgCaption" />

            <Spinner
                android:id="@+id/camera_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                style="@style/IcuNgSpinner" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_margin"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/protocol_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/IcuNgSpinner" />

            <EditText
                android:id="@+id/rtsp_url_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:inputType="textUri"
                android:hint="rtsp://host:puerto/stream"
                android:text="rtsp://10.0.2.2:8554/icung"
                style="@style/IcuNgField" />

            <Button
                android:id="@+id/qr_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/qr_button"
                style="@style/IcuNgButton.Secondary" />

            <Button
                android:id="@+id/stream_toggle_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/start_stream"
                style="@style/IcuNgButton.Primary" />

        </LinearLayout>

        <CheckBox
            android:id="@+id/klv_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_margin"
            android:text="@string/klv_checkbox"
            style="@style/IcuNgCheckBox" />

        <CheckBox
            android:id="@+id/trust_all_certs_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_margin"
            android:text="@string/trust_all_certs"
            style="@style/IcuNgCheckBox"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/srt_encryption_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_margin"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/srt_passphrase_caption"
                style="@style/IcuNgCaption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/srt_passphrase_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="textPassword"
                    android:hint="@string/srt_passphrase_hint"
                    style="@style/IcuNgField" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_gravity="center_vertical"
                    android:text="@string/srt_encryption_caption"
                    style="@style/IcuNgCaption" />

                <Spinner
                    android:id="@+id/srt_encryption_spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    style="@style/IcuNgSpinner" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>

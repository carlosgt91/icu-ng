<?xml version="1.0" encoding="utf-8"?>
<!-- android:icon: Android shows it on light backgrounds (app list,
     Settings), where the bare white glyph is invisible - so the glyph sits
     on a dark rounded tile here. ATAK itself uses ic_toolbar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#121212" />
            <corners android:radius="10dp" />
            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_toolbar"
        android:left="7dp" android:top="7dp" android:right="7dp" android:bottom="7dp" />
</layer-list>

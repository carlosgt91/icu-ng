<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded field with a chevron on the right; item gravity needs API 23,
     older systems just stretch the chevron (ATAK 5.8 targets newer). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="23">
    <item android:drawable="@drawable/field_bg" />
    <item
        android:drawable="@drawable/ic_chevron"
        android:gravity="end|center_vertical"
        android:right="10dp" />
</layer-list>
